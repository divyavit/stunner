###########
# stunnerd carrying the pre-authorized-permissions patch.
#
# The patched pion/turn is vendored as plain source at third_party/pion-turn and wired in via a
# replace directive, so a bare clone builds with no extra checkout steps:
#
#   docker build -f Dockerfile.fk \
#     --build-arg VERSION=1.2.1-fk-1 --build-arg COMMIT_HASH=$(git rev-parse --short HEAD) \
#     -t jfrog.fkinternal.com/n200m-icap/stunnerd:1.2.1-fk-1 .
#
# Kept separate from the upstream Dockerfile so rebases onto l7mp/stunner stay clean.
FROM --platform=linux/amd64 jfrog.fkinternal.com/fk-base-images/golang:1.26.0-debian13.3 AS builder

ENV GOPROXY=https://artifactory.artifactory-prod.fkcloud.in/artifactory/api/go/go_virtual \
    GOSUMDB=off

WORKDIR /workspace
COPY third_party/pion-turn/ third_party/pion-turn/
COPY go.mod go.sum ./
RUN go mod download

COPY *.go ./
COPY internal/ internal/
COPY pkg/ pkg/
COPY cmd/ cmd/

ARG VERSION=dev
ARG COMMIT_HASH=unknown
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commitHash=${COMMIT_HASH} -X main.buildDate=$(date +%FT%T%z)" \
    -o bin/stunnerd cmd/stunnerd/main.go

###########
FROM --platform=linux/amd64 jfrog.fkinternal.com/appsec.local/distroless-static-debian:nonroot

COPY --from=builder /workspace/bin/stunnerd /usr/bin/stunnerd
COPY --from=builder /workspace/cmd/stunnerd/stunnerd.conf /stunnerd.conf
USER 65532:65532

EXPOSE 3478/udp

ENTRYPOINT ["/usr/bin/stunnerd"]
CMD ["-c", "/stunnerd.conf"]
